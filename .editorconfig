root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
max_line_length = 170
csharp_style_namespace_declarations = file_scoped:error
dotnet_sort_system_directives_first = true
